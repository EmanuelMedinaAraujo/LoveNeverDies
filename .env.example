# Clerk (DESIGN.md §1). `clerk init --app app_3IEII7CYI5MAH2RIajEorZ1Fd8U`
# legt diese Datei als .env.local an. Der Publishable Key ist öffentlich; der
# Secret Key gehört niemals in eine VITE_-Variable und niemals in dieses Repo.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: zusätzliche Hosts für die Content-Security-Policy, etwa die
# Frontend-API einer Clerk-Produktionsinstanz. Kommasepariert.
# VITE_CLERK_FRONTEND_API=https://clerk.example.de

# Supabase (DESIGN.md §4). Projekt-URL und Anon-Key stehen im Dashboard unter
# Project Settings → API. Der Anon-Key ist öffentlich und liegt ohnehin im
# ausgelieferten JavaScript; was jemand damit sieht, entscheidet die RLS. Der
# Service-Role-Key gehört niemals in eine VITE_-Variable und niemals ins Repo.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ElevenLabs Conversational AI Agent ID für den Erbe-Fragebaum Sprachassistenten.
# Kann über `node scripts/setup-elevenlabs-agent.mjs` automatisch erstellt werden.
VITE_ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
