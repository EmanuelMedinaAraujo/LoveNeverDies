# Clerk (DESIGN.md §1). `clerk init --app app_3IEII7CYI5MAH2RIajEorZ1Fd8U`
# legt diese Datei als .env.local an. Der Publishable Key ist öffentlich; der
# Secret Key gehört niemals in eine VITE_-Variable und niemals in dieses Repo.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: zusätzliche Hosts für die Content-Security-Policy, etwa die
# Frontend-API einer Clerk-Produktionsinstanz. Kommasepariert.
# VITE_CLERK_FRONTEND_API=https://clerk.example.de
