{
  "name": "loveneverdies",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-legal.mjs && tsc -b && vite build",
    "build:legal": "node scripts/copy-legal.mjs",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "preview:test": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview:cf": "npm run build && wrangler dev",
    "deploy:dry": "node scripts/copy-legal.mjs && npm run build && wrangler deploy --dry-run",
    "deploy": "node scripts/copy-legal.mjs && npm run build && wrangler deploy",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "supabase db reset && node --env-file=.env.test node_modules/@playwright/test/cli.js test",
    "test:e2e:ui": "supabase db reset && node --env-file=.env.test node_modules/@playwright/test/cli.js test --ui",
    "icons": "node scripts/generate-icons.mjs",
    "build:gerichte": "python scripts/build-gerichte.py",
    "import:content": "node build/import-content.ts"
  },
  "dependencies": {
    "@clerk/localizations": "4.15.5",
    "@clerk/react": "6.14.5",
    "@elevenlabs/client": "1.23.0",
    "@elevenlabs/react": "1.15.0",
    "@noble/curves": "2.3.0",
    "@noble/post-quantum": "0.7.0",
    "@supabase/supabase-js": "2.112.3",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "shamir-secret-sharing": "0.0.3"
  },
  "devDependencies": {
    "@clerk/testing": "2.2.28",
    "@electric-sql/pglite": "0.5.6",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.2.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.0",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.11.0",
    "jsdom": "29.1.1",
    "supabase": "2.115.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  },
  "allowScripts": {
    "workerd@1.20260820.1": true
  }
}
